QMainWindow, QWidget {
    background-color: #f8f8f8;
    color: #111;
}

QLabel {
    font-family: PKMN RBYGSC;
    font-size: 18px;
    color: #111;
    background-color: transparent;
}

QPushButton {
    font-family: PKMN RBYGSC;
    font-size: 14px;
    padding: 8px 12px;
    color: #111;
    background-color: #f8f8f8;
    border: 2px solid #111;
    border-radius: 14px;
}

QPushButton:hover, QPushButton:pressed {
    background-color: #e0e0e0;
}

QPushButton:checked {
    background-color: #d0f0d0;
}

QScrollArea {
    background-color: #f8f8f8;
    border: none;
}

QListWidget {
    font-family: PKMN RBYGSC;
    font-size: 15px;
    color: #111;
    background-color: #f8f8f8;
    border: 2px solid #111;
    border-radius: 14px;
    padding: 4px;
}

QListWidget::item {
    padding: 4px 6px;
}

QLabel#typeBadge {
    font-size: 12px;
    padding: 3px 8px;
    border: 2px solid #111;
    border-radius: 10px;
}

QLabel#descriptionLabel {
    font-size: 11px;
    padding: 2px 6px;
}

QLabel#evolutionsLabel {
    font-size: 11px;
}
